# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=Freelance

# Application Configuration
NODE_ENV=development
PORT=8080

# Enable after applying the SaaS, duration, top-up, and notification migrations.
SAAS_LIFECYCLE_JOBS_ENABLED=true
# Compatibility switches remain disabled; direct instructor creation and credit edits need approved workflows.
ALLOW_LEGACY_INSTRUCTOR_CREATION=false
ALLOW_DIRECT_SERVICE_CREDIT_ADJUSTMENT=false
# Temporary emergency control requested by the product owner. Set false/remove after cleanup.
TEMP_ENABLE_INSTRUCTOR_HARD_DELETE=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# AI provider (server-side only; never prefix with VITE_)
GROQ_API_KEY=replace_with_a_rotated_server_side_key

# Session Secret (change in production)
SESSION_SECRET=your_secret_key_here

# =====================================================
# VIDEO SYSTEM - MinIO Configuration
# =====================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_password_here

# MinIO Buckets
MINIO_BUCKET_ORIGINALS=videos-original
MINIO_BUCKET_HLS=videos-hls
MINIO_BUCKET_THUMBNAILS=videos-thumbnails
MINIO_BUCKET_PREVIEWS=video-previews
MINIO_BUCKET_PAYMENT_PROOFS=payment-proofs

# Video Processing
VIDEO_MAX_SIZE_MB=5000
VIDEO_CHUNK_SIZE_MB=10
FFMPEG_THREADS=2
HLS_SEGMENT_DURATION=10
VIDEO_TEMP_DIR=/tmp/video-processing
# Set these when FFmpeg/FFprobe are not available on PATH.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Playback uses private AES-128 HLS through two-minute application sessions.
# Paid DRM integration is intentionally disabled; legacy DRM columns remain
# only for a non-destructive migration path.

# Admin User (Created automatically by seed script)
# Phone: replace_with_super_admin_phone
# Password: replace_with_strong_unique_password
# ⚠️ IMPORTANT: Change password after first login in production!
