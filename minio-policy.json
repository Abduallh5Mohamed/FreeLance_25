{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "AWS": [
                    "*"
                ]
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::videos-original/*",
                "arn:aws:s3:::videos-hls/*",
                "arn:aws:s3:::videos-thumbnails/*"
            ]
        }
    ]
}